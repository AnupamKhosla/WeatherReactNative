{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/SESSION_STATE.md"],
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "git push --force*": "deny"
    },
    "external_directory": {
      "*": "allow",
      "/Users/anupamkhosla/.ssh/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
