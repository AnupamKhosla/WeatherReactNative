{
  "expo": {
    "name": "Global Weather",
    "slug": "global-weather",
    "scheme": "globalweather",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.global.weather",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "App needs your location to show weather.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.globalweather",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4a61b61c-e886-484a-b72f-06560a99e136"
      }
    },
    "owner": "user31782",
    "plugins": [
      "expo-status-bar",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#333333",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ]
  }
}
